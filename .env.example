# Copy to .env and fill in. Never commit .env.

# Postgres (matches docker-compose.yml; host port 5434)
DATABASE_URL="postgresql://study:study@localhost:5434/study?schema=public"

# Gemini — project-specific name so a system-wide GEMINI_API_KEY can never be picked up.
# Key from https://aistudio.google.com/apikey
APP_GEMINI_API_KEY=""

# Model IDs — use the IDs enabled in your AI Studio project
LLM_MODEL_FAST="gemini-3.1-flash-lite"
LLM_MODEL_STRONG="gemini-3.1-flash-lite"
EMBED_MODEL="gemini-embedding-001"

# Tutor refusal threshold (cosine). Placeholder; calibrated in the eval module.
REFUSAL_TAU="0.55"

# UI: "1" = pages read @sc/schemas/mocks instead of calling the API (until backend modules land)
NEXT_PUBLIC_USE_MOCKS="0"
