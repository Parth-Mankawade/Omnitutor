# Copy to .env and fill in. Never commit .env.

# Postgres (matches docker-compose.yml; host port 5434)
DATABASE_URL="postgresql://study:study@localhost:5434/study?schema=public"

# Gemini — project-specific name so a system-wide GEMINI_API_KEY can never be picked up.
# Key from https://aistudio.google.com/apikey
APP_GEMINI_API_KEY=""

# Model IDs — use the IDs enabled in your AI Studio project
LLM_MODEL_FAST="gemini-3.1-flash-lite"
LLM_MODEL_STRONG="gemini-3.1-flash-lite"
EMBED_MODEL="gemini-embedding-001"

# Name of the default course, created by `npm run db:seed` (only when the course doesn't exist yet).
# Every ingestion/build prompt gets it as context, so name it after your actual material.
# COURSE_NAME="Operating Systems: CPU Scheduling"

# Tutor refusal threshold (cosine). Placeholder; calibrated in the eval module.
REFUSAL_TAU="0.55"

# Optional: Gemini quota guard (packages/core/src/limiter.ts). Defaults sit below the verified
# free tier (Flash Lite 15 RPM / 250K TPM / 500 RPD; Embedding 100 RPM / 30K TPM / 1K RPD).
# Embedding requests count once per text. Daily counts: data/cache/usage.json (Pacific day).
# LLM_RPM="12"
# LLM_TPM="200000"
# LLM_RPD="450"
# LLM_CONCURRENCY="4"
# EMBED_RPM="80"
# EMBED_TPM="24000"
# EMBED_RPD="900"
# Optional: "off" disables the on-disk Gemini result cache (data/cache/) and forces fresh calls.
# LLM_CACHE="on"

# UI data source for @sc/client:
#   auto = endpoints marked "live" in packages/schemas/src/endpoints.ts call the API, "planned" ones use mocks
#   mock = everything from @sc/schemas/mocks (offline UI work) · live = everything from the API
NEXT_PUBLIC_API_MODE="auto"
# Optional artificial latency (ms) for mocked calls, to see loading states
NEXT_PUBLIC_MOCK_DELAY_MS="0"
